# Docker Compose deployment settings. Copy to .env and use a unique random token.
CODE_RUNNER_URL=http://code-runner:8081
CODE_RUNNER_TOKEN=replace-with-at-least-32-random-characters
CODE_RUNNER_RUNTIME=runsc
CODE_RUNNER_CONCURRENCY=2

# Production deployments should also set these values.
COOKIE_SECURE=true
ALLOW_SIGNUP=false
