# Copy to backend/.env (which git ignores) and edit. Never commit your real key.

# Server-wide defaults. Each signed-in user can choose Ollama, Gemini, OpenAI, Anthropic or Azure OpenAI on Settings.
# OpenAI, Anthropic and Azure credentials are configured per account in the app and stored encrypted.
# Use Google's hosted Gemini instead of local Ollama.
# Free key: https://aistudio.google.com/apikey
# Privacy: on the free tier Google may use your prompts (your resume and the job description) to improve its products.
# AIA_LLM_PROVIDER=gemini
# AIA_GEMINI_API_KEY=your-key-here
# AIA_GEMINI_MODEL=gemini-3.5-flash-lite

# Accounts
# Close registration once your accounts exist (anyone who can reach the server can otherwise sign up).
# AIA_ALLOW_SIGNUP=false
# Set to true when the app is served over HTTPS so the session cookie is never sent over plain HTTP.
# AIA_COOKIE_SECURE=true
# Encrypts stored API keys. If unset, a random key is created in backend/data/secret.key (back it up with the database).
# AIA_SECRET_KEY=a-long-random-string

# Local development only. Keep false on a hosted server unless it has dedicated model capacity.
AIA_ENABLE_OLLAMA=true

# Optional Phase 7 code runner. It must be a separately isolated service; never point this at a general shell API.
# HTTPS is required for remote hosts. Plain HTTP is accepted only for localhost or single-label private service names.
# AIA_CODE_RUNNER_URL=https://isolated-runner.example.com
# AIA_CODE_RUNNER_TOKEN=replace-with-a-long-random-service-token
# AIA_CODE_RUNNER_TIMEOUT_SECONDS=8

# Voice mode (optional): pip install ".[voice]" then python scripts/download_voice.py
# AIA_WHISPER_MODEL=base.en     # "small.en" is more accurate and slower
# AIA_PIPER_VOICE=en_US-lessac-medium
