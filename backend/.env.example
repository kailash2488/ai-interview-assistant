# Copy to backend/.env (which git ignores) and edit. Never commit your real key.

# Use Google's hosted Gemini instead of local Ollama.
# Free key: https://aistudio.google.com/apikey
# Privacy: on the free tier Google may use your prompts (your resume and the job description) to improve its products.
# AIA_LLM_PROVIDER=gemini
# AIA_GEMINI_API_KEY=your-key-here
# AIA_GEMINI_MODEL=gemini-3.5-flash-lite
